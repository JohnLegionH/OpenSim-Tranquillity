<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Condition="!Exists('packages.config')">
      <PrivateAssets>all</PrivateAssets>
      <Version>3.9.50</Version>
    </PackageReference>
    <PackageReference Include="nini-core" Version="0.9.2.16" />
    <!-- LOCAL DEVIATION: OpenMetaverse* vendored from Library/ (1.2.13, stock/unpatched).
         upstream/develop pins OpenMetaverse* 1.0.6, a version libopenmetaverse has never
         built and which is not on the OpenSim-NGC feed (only OpenSim.Data.Model is);
         restores fail NU1101 for any clean checkout. Vendoring as upstream did prior to
         May 2026. REMOVE when NGC publishes real OMV packages and corrects the pin;
         restore the three PackageReference entries below.
           <PackageReference Include="OpenMetaverse" Version="1.0.6" />
           <PackageReference Include="OpenMetaverse.Types" Version="1.0.6" />
           <PackageReference Include="OpenMetaverse.StructuredData" Version="1.0.6" /> -->
    <Reference Include="OpenMetaverse">
      <HintPath>$(MSBuildThisFileDirectory)Library/OpenMetaverse.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenMetaverse.Types">
      <HintPath>$(MSBuildThisFileDirectory)Library/OpenMetaverse.Types.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenMetaverse.StructuredData">
      <HintPath>$(MSBuildThisFileDirectory)Library/OpenMetaverse.StructuredData.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
