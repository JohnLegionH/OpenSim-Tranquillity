[WebRtcVoice]
    Enabled=false
    ; Module to use for spatial WebRtcVoice
    ; The following is for a Janus service just for spatial voice for this region. Config in [JanusWebRtcVoice]
    SpatialVoiceService = WebRtcJanusService.dll:WebRtcJanusService
    ; The following is for a grid spatial voice service for this region. Link is WebRtcVoiceServiceURI
    ; SpatialVoiceService=WebRtcVoice.dll:WebRtcVoiceServiceConnector
    ; Module to use for non-spatial WebRtcVoice. Local voice service. Config in [JanusWebRtcVoice]
    NonSpatialVoiceService = WebRtcJanusService.dll:WebRtcJanusService
    ; The following is for a grid non-spatial voice service. For groups and IMs.  Link is WebRtcVoiceServiceURI
    ; NonSpatialVoiceService=WebRtcVoice.dll:WebRtcVoiceServiceConnector
    ; URL for the grid service that is providing the WebRtcVoiceService. Used by WebRtcVoiceServiceConnector.
    ;WebRtcVoiceServerURI = ${Const|PrivURL}:${Const|PrivatePort}
    ; Debugging: output to log file messages sent and received from the viewer. Very verbose.
    MessageDetails = false
    ; Comma-separated STUN server URIs advertised to viewers as SimulatorFeatures
    ; "stun-servers". Each entry MUST be a full ICE URI with scheme, e.g. stun:host:port.
    ; STOCK viewers REQUIRE a non-empty valid entry or WebRTC voice fails at
    ; CreatePeerConnection ("ICE server parsing failed: Empty uri"). Leave unset to omit
    ; the key (host candidates only; safe only on a patched viewer).
    ; On a LAN, reachability is irrelevant -- host candidates carry the media, so any
    ; well-formed entry satisfies the viewer. Internet-exposed grids MUST use a reachable
    ; STUN (this one, or their own coturn), since remote viewers need it for ICE.
    ; NOTE: value is unquoted (matches this addon's other keys); the emitted URI must
    ; have no surrounding quotes or libwebrtc rejects it.
    StunServers = stun:stun.l.google.com:19302
    ; Voice connectors (S-CON-1, Docs/voice/connector-build-plan.md):
    ; Marker token every voice-connector NPC name must carry as a whole word (first or last
    ; name) — the stock-viewer disclosure layer (brief Amendment 2 D3(i)). Default NPC.
    ; NpcNameToken = NPC
    ; Refuse ANY NPC-presence voice provision unless the agent is a registered voice-connector
    ; identity. Default false (deny) — NPC voice exists only through a policy record
    ; (brief Amendment 2 D2). Set true only to open the whole NPC voice surface.
    ; AllowNpcVoice = false
    ; S-CON-3 proximity-notice range in metres (the "within voice range" of brief D3(iii)).
    ; The spatial cull itself is mixer-side; this only scopes the disclosure chat line.
    ; VoiceRangeMetres = 20

[JanusWebRtcVoice]
    ; URI to access the Janus Gateway
    JanusGatewayURI = http://janus.example.org:14223/voice
    ; APIKey to access the Janus Gateway. Must be set to the same value as the Janus Gateway.
    APIToken = APITokenToNeverCheckIn
    ; URI to access the admin port on Janus Gateway
    JanusGatewayAdminURI = http://janus.example.org/admin
    ; APIKey to access the admin port on the Janus Gateway. Must be set to the same value as the Janus Gateway.
    AdminAPIToken = AdminAPITokenToNeverCheckIn
    ; Debugging: output to log file messages sent and received from Janus. Very verbose.
    MessageDetails = false

; Voice connector policy record (S-CON-1, Docs/voice/connector-build-plan.md; design in
; connector-design-brief.md Amendment 2). One [VoiceConnector.<name>] section per connector;
; the record IS the authorisation (operator-only by construction). The NPC name must carry
; [WebRtcVoice] NpcNameToken as its first or last name or the record is refused at load.
;[VoiceConnector.Recorder]
;    Enabled = true
;    NpcFirstName = Recorder
;    NpcLastName = NPC
;    ; Region-local position the connector NPC stands at (its parcel identity for the
;    ; visibility matrix)
;    Position = <128, 128, 25>
;    ; Only "estate" is supported in this plan (per-parcel scope rides ledger O-1)
;    Scope = estate
;    ; false = recording only: the sim pushes a moderation mute for the NPC identity at
;    ; registration, so nothing it sends is ever heard (brief Amendment 2 D2)
;    MayInject = false
;    AuthorisedBy = Operator Name
;    ; Optional: pin the connector to one region of a multi-region instance (scene name).
;    ; Absent = the record starts in EVERY region this instance hosts.
;    ; Region = Ebony
;    ; S-CON-7 (optional): URL the sim POSTs the NPC's chat text to for TTS injection
;    ; InjectSourceUrl = http://127.0.0.1:8090/say
    

