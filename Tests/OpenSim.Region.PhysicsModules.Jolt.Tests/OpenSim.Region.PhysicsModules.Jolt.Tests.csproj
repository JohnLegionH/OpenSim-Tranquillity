<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the Jolt module and its backend. Most drive real JoltPhysicsBackend instances and so need
    the native joltc, which the tests run on for win-x64 and linux-x64. Some read the source instead: a broken
    TempAllocator lock discipline ends in std::abort() inside joltc, which kills the test host rather than
    failing an assertion, so those invariants are checked on the code's structure.
  -->
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The joltc arrives from the JoltPhysics.Native package, under runtimes/<rid>/native/, as in the region server.
       The tests that need more than one job pool run in a child test host on the patched build kept in the
       repository (JOLT_TEST_NATIVE_BASE, TestNativeOverride). -->
  <Import Project="..\..\Source\OpenSim.Region.PhysicsModules.Jolt.Backend\JoltNative.targets" />

  <ItemGroup>
    <ProjectReference Include="..\..\Source\OpenSim.Region.PhysicsModules.Jolt.Backend\OpenSim.Region.PhysicsModules.Jolt.Backend.csproj" />
    <ProjectReference Include="..\..\Source\OpenSim.Region.PhysicsModules.Jolt\OpenSim.Region.PhysicsModules.Jolt.csproj" />
    <!-- The physics harness, whose scenarios run here as regression tests. -->
    <ProjectReference Include="..\JoltPhysicsHarness\JoltPhysicsHarness.csproj" />
  </ItemGroup>

</Project>
