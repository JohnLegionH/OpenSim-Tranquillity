<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PHYS-1. The Jolt lock discipline, tested by reading the source.

    Deliberately NO reference to Legion.Physics and no native joltc: the invariant these tests protect is
    "every native call that touches a PhysicsSystem's TempAllocator happens under _simLock", and the failure
    mode when it is broken is std::abort() inside joltc, which kills the whole test host rather than failing an
    assertion. A runtime reproduction therefore cannot be expressed as a red test; the lexical structure can,
    it is deterministic, and it is what a reviewer would have to check by hand otherwise.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- PHYS-2: the harness drives two real JoltPhysicsBackend instances, so it needs the managed binding AND the
       PATCHED joltc. The native arrives through the LegionJolt module's Content glob (runtimes/win-x64/native),
       which is also what overwrites the stock joltc that JoltPhysicsSharp's dependency maps to that path. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Addons\LegionPhysics\Legion.Physics\Legion.Physics.csproj" />
    <ProjectReference Include="..\..\Source\OpenSim.Region.PhysicsModules.LegionJolt\OpenSim.Region.PhysicsModules.LegionJolt.csproj" />
  </ItemGroup>

</Project>
