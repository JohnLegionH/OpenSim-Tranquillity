<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The physics backend: the engine-agnostic IPhysicsBackend and its Jolt implementation,
    JoltPhysicsBackend. It references no OpenSim assembly.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>OpenSim.Region.PhysicsModules.Jolt.Backend</AssemblyName>
    <RootNamespace>OpenSim.Region.PhysicsModules.Jolt.Backend</RootNamespace>
    <AssemblyTitle>OpenSim.Region.PhysicsModules.Jolt.Backend</AssemblyTitle>
    <Company>http://opensimulator.org</Company>
    <Product>OpenSim</Product>
    <Copyright>OpenSimulator developers</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><!-- 2.19.x HeightFieldShapeSettings takes float* -->
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CS0168</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The managed Jolt binding. Pinned: the patched joltc is built from the joltc commit behind
         JoltPhysics.Native 1.0.4, the native this version binds to. Changing it needs the native rebuilt
         to match (native/joltc/README.md). -->
    <PackageReference Include="JoltPhysicsSharp" Version="2.19.1" />
    <!-- The native joltc, the one JoltPhysicsSharp 2.19.1 depends on, named here so its version is pinned in one
         place. Its files flow to every application that reaches this project, under runtimes/<rid>/native/.
         JoltNative.Known records the hash of each; a new version fails JoltNativePackageTests until the record is
         checked again. -->
    <PackageReference Include="JoltPhysics.Native" Version="1.0.4" />
  </ItemGroup>

</Project>
