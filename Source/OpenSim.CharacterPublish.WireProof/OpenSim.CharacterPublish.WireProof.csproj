<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A command-line check of a running Robust that has the character publish endpoint loaded. It talks to the endpoint over
    HTTP the way the publishing service does, then reads the result back through the inventory and asset service
    connectors a region uses. It is not part of a Robust or region install.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenSim.CharacterPublish/OpenSim.CharacterPublish.csproj" />
    <ProjectReference Include="../OpenSim.CharacterPublish.Objects/OpenSim.CharacterPublish.Objects.csproj" />
    <ProjectReference Include="../OpenSim.MeshAsset/OpenSim.MeshAsset.csproj" />
    <ProjectReference Include="../OpenSim.Services.Connectors/OpenSim.Services.Connectors.csproj" />
  </ItemGroup>

</Project>
