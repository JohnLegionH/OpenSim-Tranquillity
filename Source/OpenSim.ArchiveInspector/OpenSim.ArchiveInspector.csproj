<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyTitle>OpenSim.ArchiveInspector</AssemblyTitle>
  </PropertyGroup>

  <!-- dotnet publish -p:OarExportExe=true builds the exporter alone as oar-export(.exe); an ordinary build is unchanged -->
  <PropertyGroup Condition="'$(OarExportExe)' == 'true'">
    <AssemblyName>oar-export</AssemblyName>
    <AssemblyTitle>oar-export</AssemblyTitle>
    <DefineConstants>$(DefineConstants);OAR_EXPORT_ONLY</DefineConstants>
    <!-- no ICU library is needed on Linux; the exporter formats and compares text culture-independently -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- dotnet publish -p:OarConvertExe=true builds the converter alone as oar-convert(.exe); an ordinary build is unchanged -->
  <PropertyGroup Condition="'$(OarConvertExe)' == 'true'">
    <AssemblyName>oar-convert</AssemblyName>
    <AssemblyTitle>oar-convert</AssemblyTitle>
    <DefineConstants>$(DefineConstants);OAR_CONVERT_ONLY</DefineConstants>
    <!-- no ICU library is needed on Linux; the OpenMetaverse library asks for the culture "en-us" when it starts, which invariant mode allows only with this -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup Condition="'$(OarConvertExe)' == 'true'">
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>

  <!-- dotnet publish -p:OarRestoreExe=true builds the restore tool alone as oar-restore(.exe); an ordinary build is unchanged -->
  <PropertyGroup Condition="'$(OarRestoreExe)' == 'true'">
    <AssemblyName>oar-restore</AssemblyName>
    <AssemblyTitle>oar-restore</AssemblyTitle>
    <DefineConstants>$(DefineConstants);OAR_RESTORE_ONLY</DefineConstants>
    <!-- no ICU library is needed on Linux; the OpenMetaverse library asks for the culture "en-us" when it starts, which invariant mode allows only with this -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup Condition="'$(OarRestoreExe)' == 'true'">
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>

  <!-- the single-file build carries the image library's native code for both platforms it is published for; the Linux package is the variant that does not need fontconfig -->
  <ItemGroup Condition="'$(OarExportExe)' == 'true'">
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenSim.Archive.GltfExport.Tests" />
    <InternalsVisibleTo Include="OpenSim.Archive.Converter.Tests" />
    <InternalsVisibleTo Include="OpenSim.Archive.Restore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Source/OpenSim.Archive.Inspection/OpenSim.Archive.Inspection.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Archive.GltfExport/OpenSim.Archive.GltfExport.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Archive.Compare/OpenSim.Archive.Compare.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Archive.ScriptScan/OpenSim.Archive.ScriptScan.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Archive.Eligibility/OpenSim.Archive.Eligibility.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Archive.Converter/OpenSim.Archive.Converter.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Archive.Restore/OpenSim.Archive.Restore.csproj" />
  </ItemGroup>
</Project>
