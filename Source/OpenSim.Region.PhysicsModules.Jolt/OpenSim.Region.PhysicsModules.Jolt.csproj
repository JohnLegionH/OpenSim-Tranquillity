<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Jolt physics region module. It is found through IPluginRegistryProvider (PluginRegistration.cs),
    like the other physics modules, and enables itself only when [Startup] physics = Jolt.
  -->
  <PropertyGroup>
    <AssemblyName>OpenSim.Region.PhysicsModules.Jolt</AssemblyName>
    <RootNamespace>OpenSim.Region.PhysicsModules.Jolt</RootNamespace>
    <AssemblyTitle>OpenSim.Region.PhysicsModules.Jolt</AssemblyTitle>
    <Company>http://opensimulator.org</Company>
    <Product>OpenSim</Product>
    <Copyright>OpenSimulator developers</Copyright>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Source/OpenSim.Framework/OpenSim.Framework.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Region.Framework/OpenSim.Region.Framework.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Region.PhysicsModules.SharedBase/OpenSim.Region.PhysicsModules.SharedBase.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Region.PhysicsModules.Jolt.Backend/OpenSim.Region.PhysicsModules.Jolt.Backend.csproj" />
    <ProjectReference Include="../../Source/OpenSim.Region.PhysicsModules.Jolt.Vehicles/OpenSim.Region.PhysicsModules.Jolt.Vehicles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native joltc, under runtimes/<rid>/native/ as ubODE and BulletS ship theirs. It is a patched
         build that gives every PhysicsSystem its own TempAllocator (see native/joltc/README.md); the
         backend's per-instance _simLock depends on that. The files are built by the joltc native workflow
         (.github/workflows/joltc-native.yml). win-x64 is the one loaded today; linux-x64 is shipped and not
         yet loaded. -->
    <Content Include="runtimes\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!-- The same patched joltc.dll, also copied to the output root. That is the copy that loads: the
         region server's deps.json lists no joltc asset, so the runtime finds joltc.dll in the application
         directory. The region server build output holds exactly two joltc.dll files, this one at the root
         and the one under runtimes/win-x64/native/, both the patched build. assert-patched-joltc.ps1
         checks every joltc*.dll under an output or publish directory, root first. -->
    <Content Include="runtimes\win-x64\native\joltc.dll" Link="joltc.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
