<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OpenSim.CharacterPublish: writers for the asset texts a published character puts in a resident's inventory
    (wearables, notecards), in the exact text formats the Second Life viewer writes and reads.

    This is the light half of the publish code, the part the grid's inventory server needs: the writers, the bundle model
    and the validation of a bundle, and the publish service that writes a validated bundle through the grid's asset and
    inventory service interfaces. It uses OpenMetaverse.Types (OpenMetaverse.UUID), the mesh asset reader and
    OpenSim.Services.Interfaces. It has NO reference to OpenSim.Region.* (a test checks the whole dependency closure).
    The attachment object writer and the outfit assembler are in OpenSim.CharacterPublish.Objects, which references the
    region code.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenSim.CharacterPublish</RootNamespace>
    <AssemblyName>OpenSim.CharacterPublish</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!-- CS1591: the public members are documented where their meaning is not obvious from the name. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="UtopiaSkye.OpenMetaverse" />
    <PackageReference Remove="UtopiaSkye.OpenMetaverse.StructuredData" />
    <PackageReference Remove="UtopiaSkye.OpenMetaverse.Rendering.Meshmerizer" />
    <PackageReference Remove="UtopiaSkye.OpenMetaverse.Rendering.Simple" />
  </ItemGroup>

  <ItemGroup>
    <!-- avatar_lad.xml (default parameter values) and the wearable kinds -->
    <ProjectReference Include="../OpenSimNGC.Appearance.Baking/OpenSimNGC.Appearance.Baking.csproj" />
    <!-- decodes mesh assets, so a bundle's meshes can be checked -->
    <ProjectReference Include="../OpenSim.MeshAsset/OpenSim.MeshAsset.csproj" />
    <!-- IAssetService and IInventoryService, which the publish service writes through (Robust already loads these) -->
    <ProjectReference Include="../OpenSim.Services.Interfaces/OpenSim.Services.Interfaces.csproj" />
  </ItemGroup>

</Project>
