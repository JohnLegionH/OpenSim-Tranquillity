<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OpenSim.Archive.PackagePatch: build-time tool. Copies an assembly and, in the copy, replaces the hash objects it creates
    from the framework's classes (which load the system's OpenSSL on Linux) with the managed ones of
    OpenSim.Archive.ManagedHash. The oar tools' publish runs it on the OpenMetaverse libraries.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>OpenSim.Archive.PackagePatch</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="nini-core" />
    <PackageReference Remove="UtopiaSkye.OpenMetaverse" />
    <PackageReference Remove="UtopiaSkye.OpenMetaverse.Types" />
    <PackageReference Remove="UtopiaSkye.OpenMetaverse.StructuredData" />
    <PackageReference Remove="UtopiaSkye.OpenMetaverse.Rendering.Meshmerizer" />
    <PackageReference Remove="UtopiaSkye.OpenMetaverse.Rendering.Simple" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <ProjectReference Include="../OpenSim.Archive.ManagedHash/OpenSim.Archive.ManagedHash.csproj" />
  </ItemGroup>
</Project>
